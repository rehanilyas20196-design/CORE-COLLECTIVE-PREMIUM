SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
PORT=3000
FRONTEND_URL=http://localhost:5173
PASSWORD_PEPPER=YourSecretPepperStringHere

# Admin account credentials (used to bootstrap / re-sync the admin login).
# The backend reads real environment variables (it does NOT load this .env file),
# so set these in your hosting platform / runtime environment.
# ADMIN_PASSWORD has no default — admin bootstrap fails closed if it is unset.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
